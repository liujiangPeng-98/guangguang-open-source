VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id
VITE_PUBLISHABLE_KEY=your-publishable-key
VITE_CLOUDBASE_REGION=ap-shanghai

# Optional local authentication proxy; replace with your own hosting origin.
# Do not keep the sample value when enabling the proxy.
# CLOUDBASE_AUTH_ORIGIN=https://your-env-your-appid.tcloudbaseapp.com

# VITE_ variables are public. Never place SecretKey or database passwords here.
