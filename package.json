{
  "name": "guangguang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:map": "node --experimental-strip-types --test tests/map-model.test.ts",
    "lint": "eslint src/ --fix",
    "preview": "vite preview",
    "format": "prettier --write src",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.tests.json",
    "test": "npm run test:map && npm run test:unit && npm run test:types",
    "lint:check": "eslint src/",
    "check:release": "node scripts/check-release.cjs"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.0",
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@cloudbase/js-sdk": "3.10.1",
    "lucide-react": "^1.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@cloudbase/cli": "^3.8.4",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "jsdom": "29.1.1",
    "postcss": "^8.4.47",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^6.3.5",
    "vitest": "5.0.4"
